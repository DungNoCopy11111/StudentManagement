@inherits LayoutComponentBase
@using AntDesign

<Layout Style="min-height: 100vh;">
    <Sider Collapsible Width="200">
        <div class="logo" style="height: 32px; background: rgba(255, 255, 255, 0.2); margin: 16px; color: white; text-align: center; line-height: 32px; border-radius: 6px;">
            Student Mgmt
        </div>
        
        <Menu Theme="MenuTheme.Dark" Mode="MenuMode.Inline">
            <MenuItem RouterLink="/" Icon="home">Trang chủ</MenuItem>
            <MenuItem RouterLink="/students" Icon="user">Quản lý sinh viên</MenuItem>
        </Menu>
    </Sider>

    <Layout>
        <Header Style="background: #fff; padding: 0; box-shadow: 0 1px 4px rgba(0,21,41,.08);" />
        
        <Content Style="margin: 24px 16px 0;">
            <div style="padding: 24px; background: #fff; min-height: 360px; border-radius: 8px;">
                @Body
            </div>
        </Content>
        
        <Footer Style="text-align: center;">Student Management System ©2026 Created by Gemini</Footer>
    </Layout>
</Layout>

<style>
    /* Đảm bảo nội dung không bị dính sát mép */
    .ant-layout-content {
        overflow: auto;
    }
</style>